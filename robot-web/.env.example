# Base URL of the Flask/Socket.IO server on the Pi.
#
# Use the Tailscale MagicDNS name: the Pi's LAN address (192.168.2.203) is not
# reachable from every client, but the tailnet name is. A device must have
# Tailscale connected for this to resolve.
#
# This is inlined at build time. To repoint an already-built bundle, use the
# server settings dialog in the app instead (it writes a localStorage override).
NEXT_PUBLIC_ROBOT_API_URL=http://ubuntu5:5000
